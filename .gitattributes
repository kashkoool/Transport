# Normalize line endings - LF in the repo, checked out native on Windows.
* text=auto eol=lf

*.cs text diff=csharp
*.csproj text
*.sln text eol=crlf
*.props text
*.json text
*.yml text
*.yaml text
*.md text
*.ps1 text eol=crlf
*.sh text eol=lf

# Binaries
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
