{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=transport;Username=transport;Password=change_me_local_only",
    "Valkey": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "transport-platform",
    "Audience": "transport-platform-clients",
    "SigningKey": "dev_only_signing_key_change_me_at_least_32_chars_long",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Payments": {
    "Provider": "Sandbox",
    "WebhookSecret": "dev_sandbox_webhook_secret",
    "CheckoutBaseUrl": "https://sandbox.local/checkout"
  },
  "Cors": { "AllowedOrigins": [ "http://localhost:4200" ] },
  "Proxy": { "TrustedHops": 0 },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
