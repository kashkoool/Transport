# ─────────────────────────────────────────────────────────────────────────────
# Example environment file. Copy to `.env` and fill real values for local dev.
# NEVER commit a real `.env`. Production secrets come from a secrets manager.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=transport
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=transport
POSTGRES_PORT=5432

# Connection string the API uses (matches the values above).
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=transport;Username=transport;Password=change_me_local_only

# ── Valkey (Redis-compatible cache / real-time backplane) ──
VALKEY_PORT=6379
ConnectionStrings__Valkey=localhost:6379

# ── MinIO (S3-compatible object storage: tickets, logos, reports) ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_local_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Mailpit (local SMTP capture for dev email) ──
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── Email (transactional) ──
# Leave Email__SmtpHost EMPTY in dev → the API logs emails (with the verify/reset link) instead
# of sending. Point it at Mailpit (localhost:1025) or a real relay to actually send.
Email__SmtpHost=
Email__SmtpPort=1025
Email__UseStartTls=false
Email__FromAddress=noreply@tpx.local
Email__FromName=TPX Travel
# Absolute URL of the web app — used to build links in emails (compose serves it on :8080).
Email__FrontendBaseUrl=http://localhost:8080

# ── JWT (auth) ──
# Generate a long random secret for real use: at least 32 bytes / 64 hex chars.
Jwt__Issuer=transport-platform
Jwt__Audience=transport-platform-clients
Jwt__SigningKey=change_me_to_a_long_random_secret_at_least_32_chars
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# ── Google sign-in (optional) ──
# Leave ClientId EMPTY to disable Google sign-in (dev default). To enable: create an OAuth client
# in Google Cloud Console and set the authorized redirect URI to <api-origin>/signin-google.
OAuth__Google__ClientId=
OAuth__Google__ClientSecret=
OAuth__Google__CallbackPath=/signin-google

# ── Payment gateway (sandbox adapter for now; no card data ever stored) ──
Payments__Provider=Sandbox
Payments__WebhookSecret=change_me_sandbox_webhook_secret

# ── API ──
ASPNETCORE_ENVIRONMENT=Development
Cors__AllowedOrigins=http://localhost:4200
# Host-header allow-list (semicolon-separated). Production MUST be explicit hosts, never "*".
AllowedHosts=localhost;127.0.0.1;[::1]
# Reverse-proxy hop count (Cloudflare+Nginx=2). Must be > 0 in production for real-IP rate limits.
Proxy__TrustedHops=0
