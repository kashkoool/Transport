# ─────────────────────────────────────────────────────────────────────────────
# Example environment file. Copy to `.env` and fill real values for local dev.
# NEVER commit a real `.env`. Production secrets come from a secrets manager.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=transport
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=transport
POSTGRES_PORT=5432

# Connection string the API uses (matches the values above).
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=transport;Username=transport;Password=change_me_local_only

# ── Valkey (Redis-compatible cache / real-time backplane) ──
VALKEY_PORT=6379
ConnectionStrings__Valkey=localhost:6379

# ── MinIO (S3-compatible object storage: tickets, logos, reports) ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_local_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Mailpit (local SMTP capture for dev email) ──
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── JWT (auth) ──
# Generate a long random secret for real use: at least 32 bytes / 64 hex chars.
Jwt__Issuer=transport-platform
Jwt__Audience=transport-platform-clients
Jwt__SigningKey=change_me_to_a_long_random_secret_at_least_32_chars
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# ── Payment gateway (sandbox adapter for now; no card data ever stored) ──
Payments__Provider=Sandbox
Payments__WebhookSecret=change_me_sandbox_webhook_secret

# ── API ──
ASPNETCORE_ENVIRONMENT=Development
Cors__AllowedOrigins=http://localhost:4200
